# Build artifacts
build/
build-pkg/
cmake-build-*/

# 测试/打包临时产物
.t/
.selftest/
.selftest-mcp/
.selftest*/
.tmp/
packaging/stage/
packaging/stage-rpm/
packaging/rpmbuild/
